[tasks]
bmc
prove
cover

[options]
bmc:   mode bmc
bmc:   depth 24
prove: mode prove
prove: depth 12
cover: mode cover
cover: depth 20
timeout 1800

[engines]
bmc:   btor btormc
bmc:   smtbmc boolector
prove: abc pdr
prove: smtbmc boolector
cover: smtbmc yices

[script]
plugin -i slang
read_slang --top loom_core loom_core.v loom_decode.v loom_regfile.v loom_alu.v loom_be.v loom_timer.v loom_fifo.v loom_sched_props.v
prep -top loom_core
# `abc pdr` exports AIGER, which refuses a design that still holds x or z
# constants: newer Yosys builds than the one this was written on leave some
# behind (CI run 35524275257 died here while the same proof passed locally).
# Replacing them with free variables rather than zeros keeps the proof an
# over-approximation: anything proved still holds for every value they could
# have had.
setundef -undriven -anyseq

[files]
../src/loom_core.v
../src/loom_decode.v
../src/loom_isa.vh
../src/loom_regfile.v
../src/loom_alu.v
../src/loom_be.v
../src/loom_timer.v
../src/loom_fifo.v
props/loom_sched_props.v
