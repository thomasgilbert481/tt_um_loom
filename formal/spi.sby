[tasks]
bmc
prove
cover
xfail

[options]
bmc:   mode bmc
bmc:   depth 70
prove: mode prove
prove: depth 20
cover: mode cover
cover: depth 140
xfail: mode bmc
xfail: depth 80
xfail: expect fail
timeout 1800

[engines]
bmc:   smtbmc --keep-going yices
prove: abc pdr
prove: smtbmc yices
cover: smtbmc yices
xfail: smtbmc --keep-going yices

[script]
plugin -i slang
bmc:   read_slang --top loom_spi_host loom_spi_host.v loom_sync.v loom_spi_props.v
prove: read_slang --top loom_spi_host loom_spi_host.v loom_sync.v loom_spi_props.v
cover: read_slang --top loom_spi_host loom_spi_host.v loom_sync.v loom_spi_props.v
xfail: read_slang -D LOOM_FV_SPI_RESET_IN_TRANSACTION --top loom_spi_host loom_spi_host.v loom_sync.v loom_spi_props.v
prep -top loom_spi_host
# `abc pdr` exports AIGER, which refuses a design that still holds x or z
# constants: newer Yosys builds than the one this was written on leave some
# behind (CI run 35524275257 died here while the same proof passed locally).
# Replacing them with free variables rather than zeros keeps the proof an
# over-approximation: anything proved still holds for every value they could
# have had.
# The undefined initial contents of a memory (the register file) become x
# constants when it is mapped to flops, so map first, then clear them.
memory_map
setundef -undriven -anyseq

[files]
../src/loom_spi_host.v
../src/loom_sync.v
props/loom_spi_props.v
