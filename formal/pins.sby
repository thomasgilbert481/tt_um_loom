[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 12
cover: mode cover
cover: depth 16
timeout 600

[engines]
prove: smtbmc yices
cover: smtbmc yices

[script]
plugin -i slang
prove: read_slang --top loom_pins loom_pins.v loom_sync.v loom_pin_props.v
cover: read_slang --top loom_pins loom_pins.v loom_sync.v loom_pin_props.v
prep -top loom_pins
# `abc pdr` exports AIGER, which refuses a design that still holds x or z
# constants: newer Yosys builds than the one this was written on leave some
# behind (CI run 35524275257 died here while the same proof passed locally).
# Replacing them with free variables rather than zeros keeps the proof an
# over-approximation: anything proved still holds for every value they could
# have had.
setundef -undriven -anyseq

[files]
../src/loom_pins.v
../src/loom_sync.v
props/loom_pin_props.v
