; uart_hello.loom
; The M1 acceptance program: thread 0 sends "LOOM\r\n" on OUT0 as 8N1 UART at
; 115200 baud from a 50 MHz clock, then halts.
;
; 50e6 / 115200 = 434.03 clocks per bit, so one tick is one bit period and
; every bit boundary is a WAITD 1. Because WAITD advances TD from the previous
; deadline rather than from "now", the schedule has no accumulated drift
; whatever the instruction path between two bits was.
;
; The edges are not exactly one tick apart, though. A thread gets an X cycle
; only every 4 clocks (docs/SEMANTICS.md section 2, "Slot grid"), so a wait
; completes at the first X cycle at or after its deadline and each edge lands
; 0 to 3 clocks late. At TICK_INT 434 the deadlines fall on 434, 868, 1302 ...
; while the edges land on the 4-clock grid, so consecutive bit edges alternate
; 432 and 436 clocks apart. The lateness never accumulates: the 10-bit frame
; spacing is exactly 4340 clocks, which is what a receiver samples against.
; Choosing a tick period that is a multiple of 4 clocks makes the lateness
; constant and the edges exactly periodic; 432 and 436 are both within 0.5 per
; cent of 115200 baud, well inside what 8N1 tolerates.
;
; No FIFO instruction appears here. At M1 the FIFOs do not exist, so the byte
; to send is loaded into r0 with LDI and send_byte is reached with CALL/RET.
; uart_tx.loom is the same transmitter fed from INQ, which is the M2 form.
;
; Assemble:  python -m tools.loomasm firmware/uart_hello.loom \
;                -o firmware/build/uart_hello.json --listing

        .thread 0
        .pins   TX = OUT0

        .csr    TICK_INT,  434          ; one tick = one 115200 baud bit
        .csr    TICK_FRAC, 0            ; (clobbers r7, the .csr scratch)

start:  SETP    TX, 1                   ; the line idles high
        SETD    0                       ; anchor the schedule: TD = NOW

        LDI     r0, 'L'
        CALL    send_byte
        LDI     r0, 'O'
        CALL    send_byte
        LDI     r0, 'O'
        CALL    send_byte
        LDI     r0, 'M'
        CALL    send_byte
        LDI     r0, '\r'
        CALL    send_byte
        LDI     r0, '\n'
        CALL    send_byte
        HALT                            ; stops thread 0 after the last stop bit

; ---------------------------------------------------------------------------
; send_byte: transmit r0 as one 8N1 frame, LSB first. Clobbers r0 and r1.
; TD is already on a bit boundary on entry and is left on the boundary at the
; end of the stop bit, so consecutive calls produce a gapless byte stream.
; ---------------------------------------------------------------------------
send_byte:
        SETP    TX, 0                   ; start bit
        WAITD   1
        LDI     r1, 8                   ; eight data bits

bit:    SHRI    r0, 1                   ; C = the next bit out, LSB first
        BC      one
        SETP    TX, 0
        BRA     next
one:    SETP    TX, 1
next:   WAITD   1                       ; the deadline sets the edge, not the
                                        ; length of the path that reached it
        DJNZ    r1, bit

        SETP    TX, 1                   ; stop bit
        WAITD   1
        RET
