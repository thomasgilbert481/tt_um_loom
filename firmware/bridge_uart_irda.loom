; bridge_uart_irda.loom
; A UART-to-IrDA SIR bridge: thread 0 receives a plain serial stream (8N1)
; on RX and queues the bytes in a ring in data memory; thread 1 sends them
; as SIR pulses on TX, at the same bit rate. No host in the loop: the host
; loads the image, sets the two ticks, optionally pushes one configuration
; word to INQ[1], starts both threads, and afterwards reads only the error
; words thread 0 pushes to OUTQ[0]. It is the job an IrDA dongle's ENDEC
; and UART do between a PC's serial port and the LED.
;
; Written on 2026-11-05, after the hardware was complete (D-032), as a
; protocol Loom was not designed for (D-035). It uses the M2 core (pins,
; deadlines, the FIFOs for the configuration and error words) and LD/ST to
; data memory (SEMANTICS 6.11, built so device emulators can keep a
; register file), here as the hand-off between the two threads. No
; hardware knows either side: the UART framing is firmware/uart_rx.loom's
; (its slow entry), the SIR encoder is firmware/irda_sir_tx.loom's with
; its INQ replaced by the ring.
;
; Readings taken on the open spec questions (2026-11-06): the IrPHY 1.4
; PDF could not be fetched, so every figure is from Vishay application
; note 82513 rev. 1.5, which reproduces its tables, and is to be checked
; against IrPHY when it is read. Where the note's table (5.96 and 4.34 us
; at 38.4 and 57.6 kbit/s) and its written rule (5.53 and 3.86 us) differ
; on the longest pulse, the stricter rule is taken. The pulse's place in
; its bit cell is in neither source: the transmitter centres it and the
; receiver does not depend on it.
;
; Pins: RX = IN0 (thread 0, the plain UART input), TX = OUT0 (thread 1,
; high = LED on, to a transceiver's TXD).
;
; Rates. Thread 0's tick is 1/8 of the UART bit (uart_rx.loom's
; convention: 115200 baud at 50 MHz is TICK 54 + 64/256), and its pairs
; are proved for ticks of 16 clocks or more. Thread 1's tick and its
; configuration word are irda_sir_tx.loom's: 1/16 of the bit with N = 1
; (TICK 27 + 33/256 at 115.2 kbit/s), or 1/16 of a 115.2 kbit/s bit with
; N = 115200 / rate and, for 1.63 us pulses, F = 1. Push the word (0x8000
; | F << 4 | N) to INQ[1] before RUN; thread 1 reads INQ[1] once, at start,
; and never again. Both sides must be set to the same bit rate.
;
; The ring: 16 words at 0x001 .. 0x010 (one byte a word), HEAD at 0x011
; (written by thread 0 only: the next word it will fill) and TAIL at 0x012
; (thread 1 only: the next word it will send). Empty is HEAD == TAIL;
; thread 0 never fills the last free word, so full is HEAD + 1 == TAIL
; (mod 16): 15 bytes. An LD or ST is one access at one edge, so neither
; thread ever sees a word half written; each publishes its index after the
; data word it covers, so the other never reads a byte before it is stored
; or overwrites one before it is sent. The SIR side sends 10 bits a byte,
; as the UART side receives them, so the ring stays near empty; it fills
; only when the UART sender is faster than thread 1's tick, by a byte
; every 1 / error characters: 15 bytes last about 1,700 characters of an
; unbroken stream from a sender 0.87 % fast (IrPHY's rate tolerance).
;
; Errors (OUTQ[0]): a byte with a low stop bit (bit 8) or one that found
; the ring full (bit 10) is not forwarded; thread 0 pushes the byte with
; that bit set if OUTQ has room (otherwise the word is lost; the host is
; not in the data path). After a framing error thread 0 waits for the line
; to go high before it looks for the next start bit, as uart_rx.loom does.
;
; Timing. Thread 0 checks for room during the stop bit, before its sample;
; after a good stop sample it stores and publishes in 8 slots (32 clocks)
; and is back at the start-bit wait, inside the half bit (4 ticks, 64
; clocks at the shortest tick) a back-to-back byte leaves, less the
; sample's lateness of up to 12 clocks. Thread 1's every edge is the first
; instruction after its WAITD, as in irda_sir_tx.loom; between bytes it
; reads HEAD and, if the ring is empty, polls it and re-anchors with
; SETD 1 when a byte arrives, so a start cell is always whole.
;
; Memory: thread 0 is 0x000 .. 0x03A (59 words) with the ring and the two
; indices at 0x001 .. 0x012 (word 0 jumps over them), thread 1 0x080 ..
; 0x0C5 (70 words);
; threads 2 and 3 are free.

        .imem   512                     ; the macro build: quarters of 128 words
        .pins   RX = IN0, TX = OUT0
        .equ    OVS  = 8                ; UART ticks a bit (thread 0)
        .equ    RING = 0x001            ; 16 words
        .equ    HEAD = 0x011            ; thread 0 writes it
        .equ    TAIL = 0x012            ; thread 1 writes it

; ======================================== thread 0: UART into the ring
; r0 the byte, r1 bits left, r2 = 0x80, r3 HEAD's value, r4 the next
; HEAD, r5 = 0 (the base for HEAD and TAIL), r6 TAIL's value, r7 scratch.
        .thread 0
        .tick   16                      ; the shortest tick the pairs are proved for
        JMP     t0
        .word   0, 0, 0, 0, 0, 0, 0, 0  ; the ring, RING .. RING + 15
        .word   0, 0, 0, 0, 0, 0, 0, 0
        .word   0                       ; HEAD
        .word   0                       ; TAIL
t0:     LDI     r2, 0x80                ; a received 1 enters at bit 7
        LDI     r3, 0
        LDI     r5, 0

rearm:  WAITP   RX, 0                   ; the start bit (or already low)
        SETD    0                       ; re-anchor on its edge
        WAITD   OVS / 2                 ; the middle of the start bit
        JP      RX, 1, rearm            ; high again: a glitch
        LDI     r0, 0
        LDI     r1, 8
bit:    WAITD   OVS                     ; the middle of the next data bit
        JP      RX, 1, one
        SHRI    r0, 1                   ; a 0 enters at bit 7
        DJNZ    r1, bit
        JMP     stop
one:    SHRI    r0, 1
        OR      r0, r0, r2
        DJNZ    r1, bit

stop:   MOV     r4, r3                  ; during the stop bit: the next HEAD
        ADDI    r4, 1
        ANDI    r4, 15
        LD      r6, r5, TAIL
        CMP     r4, r6                  ; Z: the ring is full
        WAITD   OVS                     ; the middle of the stop bit
        JP      RX, 0, ferr             ; low: framing error
        BZ      full
        ST      r0, r3, RING            ; the byte, then the index that covers it
        MOV     r3, r4
        ST      r3, r5, HEAD
        JMP     rearm

full:   LDI     r7, 0
        LDIH    r7, 4                   ; bit 10: the ring was full
        JMP     report
ferr:   LDI     r7, 0
        LDIH    r7, 1                   ; bit 8: framing error
report: OR      r0, r0, r7
        WAITB   OUTQ_NF, T              ; TD (the stop sample's) is reached:
        BT      lost                    ; T = 1 means OUTQ is full
        .bounded "the WAITB OUTQ_NF, T just before completed by its condition, and only the host takes words out"
        PUSH    r0
lost:   WAITP   RX, 1                   ; the line back to idle (a break ends)
        JMP     rearm

; ======================================== thread 1: the ring out as SIR
; irda_sir_tx.loom with its INQ replaced by the ring: r0 the frame (start
; and data bits; the stop cell is sent apart), r1 bits left, and 0 between
; frames (the base for HEAD and TAIL), r2 a loop count (then HEAD's
; value), r3 the pulse's WAITD 3 count, r4 the tail's WAITD 6 count, r5
; N, r6 the tail's WAITD 9 count, r7 TAIL's value.
        .thread 1
        .tick   16                      ; the shortest tick the pairs are proved for
t1:     SETP    TX, 0                   ; LED off: the line idles low
        OEP     TX, 1
        LDI     r5, 1                   ; N = 1, F = 0 unless INQ[1] says otherwise
        LDI     r3, 1
        LDI     r4, 1
        LDI     r6, 0
        LDI     r7, 0                   ; TAIL = HEAD = 0 at load
        LDI     r1, 0
        SETD    0                       ; TD reached: the test cannot wait
        WAITB   INQ_NE, T               ; a configuration word, once
        BT      next
        .bounded "the WAITB INQ_NE, T just before completed by its condition, so INQ holds a word"
        POP     r0
        MOV     r5, r0
        ANDI    r5, 15                  ; N
        BNZ     cfgf
        LDI     r5, 1                   ; N = 0 reads as 1
cfgf:   MOV     r3, r5                  ; F = 0: pulse 3 * N, tail 6 * N
        MOV     r4, r5
        ANDI    r0, 16                  ; F
        BZ      cfgend
        LDI     r3, 1                   ; F = 1: pulse 3, tail 6 + 9 * (N - 1)
        LDI     r4, 1
        MOV     r6, r5
        SUBI    r6, 1
cfgend: SETD    0

next:   LD      r2, r1, HEAD            ; r1 = 0 here
        CMP     r2, r7                  ; Z: the ring is empty
        BZ      idle
have:   LD      r0, r7, RING
        ADDI    r7, 1
        ANDI    r7, 15
        ST      r7, r1, TAIL            ; the word is free again
        SHLI    r0, 8                   ; drop bits 15:8
        SHRI    r0, 7                   ; the byte in bits 8:1, start bit 0 = 0
        LDI     r1, 9                   ; start and eight data bits

sbit:   SHRI    r0, 1                   ; C = the next bit, LSB first
        MOV     r2, r5                  ; N (MOV keeps C)
        BC      sone
zlead:  DJNZ    r2, zwait               ; N - 1 times round, then fall through
        WAITD   7
        SETP    TX, 1                   ; pulse starts, 7 * N ticks into the cell
        MOV     r2, r3
plead:  DJNZ    r2, pwait
        WAITD   3
        SETP    TX, 0                   ; pulse ends
        MOV     r2, r4
tail6:  WAITD   6
        DJNZ    r2, tail6
        MOV     r2, r6
        TEST    r2, r2
        BZ      done
tail9:  WAITD   9
        DJNZ    r2, tail9
        JMP     done
zwait:  WAITD   7
        JMP     zlead
pwait:  WAITD   3
        JMP     plead
sone:   WAITD   16
        DJNZ    r2, sone
done:   DJNZ    r1, sbit
        MOV     r2, r5                  ; the stop cell: 16 * N ticks dark
stopc:  WAITD   16
        DJNZ    r2, stopc
        JMP     next                    ; r1 = 0 again; TD is the stop cell's end

idle:   LD      r2, r1, HEAD            ; poll until thread 0 publishes
        CMP     r2, r7
        BZ      idle
        SETD    1                       ; the start cell begins at a whole tick
        JMP     have
