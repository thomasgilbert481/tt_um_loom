; bell202_mod.loom
; A Bell 202 FSK modulator (1200 baud, mark 1200 Hz, space 2200 Hz): sends
; bytes from the host as asynchronous characters, 8N1 or HART's 8O1, one
; tone per bit with the phase continuous across bit boundaries, and a mark
; tone while idle.
;
; Written on 2026-11-07, after the hardware was complete (D-032), as a
; protocol Loom was not designed for (D-035). Bell 202 is not a digital line
; code at all but frequency-shift keying, and nothing in Loom was built for
; it: there is no oscillator, no frequency synthesiser and no modem. The
; program uses:
;   - the per-thread fractional tick (TICK_INT/TICK_FRAC, built for UART
;     baud rates): at 50 MHz one tick is 315 + 168/256 clocks, 1/132 of a
;     bit, so both tones and the bit are whole numbers of ticks;
;   - the deadline schedule (WAITD 1 every tick, proved by the checker);
;   - the deadline-latched pin write (SETP ... D, SEMANTICS 6.10, built for
;     clock-exact UART and WS2812 edges): every edge lands on the exact
;     clock of a tick, whatever path the code took to decide it.
; What the firmware does that no hardware does: the tone synthesis itself (a
; numerically controlled oscillator in software, one phase step per tick),
; the switch between the tones at bit boundaries without a phase jump, the
; asynchronous framing, HART's odd parity, and the idle mark tone.
;
; The signal is a logic-level square wave on TX. Bell 202 and HART put a
; sine on the line: an external filter (a two-pole low-pass near 2.5 kHz, or
; the band-pass of a HART modem's front end) turns this square wave into
; one, and the analog levels (HART's 0.5 mA, 1 mA p-p current, or a
; telephone line's -12 dBm) belong to that front end, not to Loom. The odd
; harmonics of a square wave are 3 f and above (3.6 kHz for mark, 6.6 kHz
; for space), outside the band, so the filter's job is ordinary.
;
; Director's decisions (2026-11-07): mark = 1 = 1200 Hz; the line always
; carries a tone (no carrier-off, which HART masters use between messages:
; a later bit in the host word if a demo needs it); no V.23. The source
; documents' section numbers stay unchecked; the values match the HART
; modem datasheets (secondary), as tools/protomodels/bell202.py marks.
;
; Standards (tools/protomodels/bell202.py gives the full list and marks
; what could not be checked): Bell System Technical Reference PUB 41212
; (Data Sets 202S and 202T): mark (binary 1) 1200 Hz, space (binary 0)
; 2200 Hz, up to 1200 bit/s, asynchronous; HCF_SPEC-54 (HART FSK Physical
; Layer): the same two tones, 1200 bit/s +-1 %, continuous phase at bit
; boundaries; HCF_SPEC-81 (HART Data Link): 8 data bits, odd parity, one
; stop bit. ITU-T V.23 is the CCITT cousin at 1300/2100 Hz; this program is
; Bell 202 only, though V.23's tones are another two constants (QUESTIONS).
;
; Tick arithmetic. Let the tick rate be 132 * 1200 = 158 400 Hz. Then
;   bit                  132 ticks
;   mark half-period      66 ticks   (1200 Hz: 158 400 / 2400)
;   space half-period     36 ticks   (2200 Hz: 158 400 / 4400)
; At 50 MHz the exact divider is 315.65657 clocks; TICK_INT 315 with
; TICK_FRAC 168 gives 315.65625, so the tick, the two tones and the baud
; rate are all 1.0 ppm fast (0.0001 %, against HART's +-1 %). The edges sit
; on the fractional tick grid: in a steady tone a half-period alternates
; between the two whole-clock neighbours of its exact length, with no drift.
;
; The oscillator. r0 holds the phase still to go in the current half-cycle,
; minus one, in units of 1/396 half-cycle: mark spends 6 units a tick (396 /
; 66), space 11 (396 / 36). When a step would pass zero the output toggles
; and r0 gains 396, keeping the remainder, so the phase carries across the
; tone change at a bit boundary: there is never a jump. Nor is there any
; rounding: a mark bit is 792 units and a space bit 1452, both multiples of
; 66, and 66 units is a whole number of ticks in either tone (11 of mark, 6
; of space), so every crossing of the ideal continuous-phase wave, the ones
; in a half-cycle that straddles a tone change included, falls exactly on a
; tick. The toggle is staged with SETP ... D and lands on the next tick,
; one tick after the tick that decided it, for every edge alike; the only
; error left is the fractional tick's one-clock dither (the tests check
; every edge against the ideal wave to two clocks).
;
; Pins: TX = OUT0 (any output or BIDIR pin with --pin TX=<pin>; JP reads a
; BIDIR pin back through the pad, SEMANTICS 3, which works the same).
;
; Host command format (FIFO space, thread 0): one word per character.
;     bits 7:0   the byte, LSB first on the wire
;     bit 8      0: 8N1 (Bell 202 data, caller ID); 1: 8O1 (HART)
;     bits 15:9  ignored
; Characters queued back to back go out with one stop bit between them; an
; empty queue at a bit boundary sends one more bit of mark and looks again.
; Nothing is ever pushed to OUTQ.
;
; Rate: the host sets TICK_INT 315, TICK_FRAC 168 before RUN (50 MHz). The
; schedule is proved for TICK_INT >= the .tick below, so a slower board
; clock works with the tick it gives (tools/tests/test_fw_bell202.py runs
; the RTL at a 16.47 MHz board clock, tick 104 clocks: the same waveform in
; microseconds, three times fewer clocks).
;
; Memory: 41 words, 0x000 to 0x028 of thread 0's quarter (.imem 512). With
; bell202_demod.loom moved to thread 1 (0x080) the two fit together.
;
; Deadlines: two pairs, both proved. The worst is a tick that both ends a
; half-cycle and starts an 8O1 character: 25 slots = 100 clocks, which is
; the .tick 100 below (TICK_INT 315 at 50 MHz leaves 215 clocks of slack).

        .imem   512
        .thread 0
        .pins   TX = OUT0

        .equ    BIT_T  = 132                    ; ticks a bit
        .equ    HALF   = 396                    ; phase units a half-cycle
        .equ    MARK   = 6                      ; units a tick at 1200 Hz (396 / 66)
        .equ    SPACE  = 11                     ; units a tick at 2200 Hz (396 / 36)
        .tick   100                             ; the fastest tick the schedule is proved for

; r0 phase to go - 1   r1 phase step (MARK or SPACE)   r2 ticks left in the bit
; r3 the bits still to send, LSB next   r4 how many   r5 HALF   r6 the word

start:  SETP    TX, 1                   ; a half-cycle starts high
        OEP     TX, 1                   ; drive it (a no-op unless TX is a BIDIR pin)
        MOV16   r5, HALF
        MOV16   r0, HALF - 1            ; a whole half-cycle to go
        LDI     r2, BIT_T
        SETD    1
idle:   LDI     r3, 1                   ; nothing queued: one bit of mark,
        LDI     r4, 1                   ; then look again
next:   SUBI    r4, 1
        SHRI    r3, 1                   ; C = the next bit, LSB first
        LDI     r1, MARK                ; 1 is mark (LDI keeps C)
        BC      tick
        LDI     r1, SPACE               ; 0 is space

tick:   WAITD   1
        SUB     r0, r0, r1              ; C = 0: this tick ends the half-cycle
        BC      count
        ADD     r0, r0, r5              ; the remainder carries into the next one
        JP      TX, 1, fall
        SETP    TX, 1, D                ; staged: lands on the next tick exactly
        JMP     count
fall:   SETP    TX, 0, D
count:  DJNZ    r2, tick

        LDI     r2, BIT_T               ; a bit boundary: the tone may change
        CMPI    r4, 0                   ; here, and only here, phase untouched
        BNZ     next
        WAITB   INQ_NE, T               ; TD has passed: T = 0 only if a word is queued
        BT      idle
        .bounded "the WAITB INQ_NE, T just before completed by its condition, so INQ holds a word; only this thread pops INQ"
        POP     r6                      ; cannot block
        MOV     r3, r6                  ; the byte, LSB first, after the start bit
        LDIH    r3, 0xFF                ; 8N1: stop bit (bit 8), then mark
        LDI     r4, 9                   ; eight data bits and the stop bit
        SHRI    r6, 9                   ; C = bit 8 of the word: 8O1
        BNC     startb
        LDI     r4, 10                  ; 8O1: the parity bit too, before the stop bit
        PAR     r6, r3                  ; C = XOR of the byte (the 0xFF adds nothing)
        BNC     startb                  ; an even byte: parity bit 1, already there
        LDIH    r3, 0xFE                ; an odd byte: parity bit 0
startb: LDI     r1, SPACE               ; the start bit is a 0: space from this tick
        JMP     tick
