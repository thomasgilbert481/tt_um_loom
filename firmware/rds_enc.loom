; rds_enc.loom
; RDS / RBDS (IEC 62106, NRSC-4) encoder at baseband: the biphase-coded,
; differentially coded data signal on OUT0, ready for a 57 kHz DSB
; modulator. Sends a cycle of four groups from a data-memory table,
; without gaps, for as long as it runs.
;
; Written on 2026-11-26, after the hardware was complete (D-032), as a
; protocol Loom was not designed for (D-035): RDS is in no design
; document. Hardware reused from other jobs: the CRC unit of the bit
; engine (SEMANTICS 6.9), built for CRC-5/CRC-16 on USB and the CAN CRC,
; computes each block's checkword. The RDS code's generator x^10 + x^8 +
; x^7 + x^5 + x^4 + x^3 + 1 is a 10-bit "CRC" left-aligned in the 16-bit
; register (CRC_POLY = 0x1B9 << 6, CRC_INIT = 0): sixteen SHOs (to no pin)
; leave m(x) x^10 mod g(x) in CRC[15:6], NRSC-4-A 2.3 a), and one XOR adds
; the block's offset word (2.3 b), Annex A). The deadline-latched pin
; write (SETP ... D, SEMANTICS 6.10, built for WS2812) lands every
; half-symbol edge on the exact clock of its tick. What the firmware does
; that no hardware does: the group and block sequence, the offset words
; (C' in block 3 of a version B group), the differential coding and the
; biphase symbols.
;
; Wire format (NRSC-4-A Part I and annexes, ITU-R BS.643-3 Annex 1; the
; sections as tools/protomodels/rds.py cites them): 1187.5 bit/s
; (BS.643-3 1.4: +- 0.125 bit/s); differential coding, a 1 complements the
; output and a 0 keeps it (1.6 Table 1); each output bit a biphase symbol
; of two opposite half-symbols (1.7); here a 1 is high then low and a 0
; low then high (the polarity is in an equation image the extractor could
; not read: from memory, unchecked; a receiver does not care, 1.6 Table 2).
; A group is 4 blocks of 16 information bits and a 10-bit checkword, MSB
; first, no gaps (2.1, 2.2). The pin rests low until the first symbol.
;
; Tick (set by the host before RUN): HALF a bit, a half-symbol (2375 a
; second): 21052 + 162/256 at 50 MHz (+0.06 ppm), 18947 + 94/256 at 45 MHz
; (-0.07 ppm), against BS.643-3's +-105 ppm. Every edge is `SETP TXD, v, D`
; landed by a WAITD, so every half-symbol is exactly one tick. The
; schedule is proved for ticks of 256 clocks or more (the .tick below).
;
; Data (data memory, loaded with the image; the host may rewrite it with
; IMEM writes before RUN or while running): `tab`, 16 information words,
; the four blocks of four groups in transmission order; a word is read at
; the end of the block two before the one that carries it. `offs`, the
; offset words A, B, C, D, C' (Annex A Table A.1), left-aligned. Block 3
; takes C' when bit 11 (B0, NRSC-4-A 3.1.2) of the group's block 2 is 1.
; The image's table is four type 0A groups (3.1.5.1): PI 0x54A8, TP 1,
; PTY 5, M/S 1, DI 0001 one bit a group (d3 first), AF 224/205 in block 3,
; and the PS name "LOOM RDS", two characters a group by segment address
; C1 C0. (The bit positions of TP, PTY, TA, M/S, DI and C1 C0 in block 2
; are in a figure image: from memory, unchecked; the firmware only moves
; words.)
;
; Registers: r0 the word being sent (its next bit at bit 15), r1 the
; checkword of the block on the air (left-aligned), r2 bits of the block
; taken, r3 the block on the air (0..15), r4 the output level (the
; differentially coded bit), r5 the next block's information word (in the
; CRC unit while this block goes out), r6 2 if this group's block 3 takes
; C' (an index step in offs), r7 scratch. Nothing in the FIFOs.
;
; Size: 103 words, 0x000-0x074 (82 of code, 21 of data at 0x060), inside
; thread 0's quarter. `--strict` and `--staged-edges`: 8 deadline pairs,
; worst slack 44 clocks at the 256-clock tick (a block's end: the
; checkword out of the CRC unit, the offset, the next block's word into
; it), so every staged edge is exact (5 clocks needed). The air is
; anchored by SETD 3 and the first staged edge's WAITD issues 46 slots
; (184 clocks) later, under the 2 ticks that rule out an early edge.

        .imem   512                     ; the macro build: quarters of 128 words
        .thread 0
        .pins   TXD = OUT0
        .tick   256                     ; the shortest half-symbol the work is proved for
        .equ    POLY = 0x1B9 << 6       ; g(x) without x^10, left-aligned (2.3)

start:  .csr    BE_CFG, 0x202           ; DIR = 1 (MSB first), CRC_EN; NRZ
        .csr    BE_PINS, 13             ; SHO to no pin: the CRC unit only
        .csr    CRC_POLY, POLY          ; CRC_INIT stays 0
        SETP    TXD, 0
        MOV16   r7, tab
        LD      r5, r7, 0               ; block 0's information word
        LDSR    r5
        CRCI
        LDI     r2, 16
pre:    SHO                             ; its checkword, before the air
        DJNZ    r2, pre
        LDI     r2, 26                  ; as though block 15 had just ended
        LDI     r3, 15
        LDI     r4, 0                   ; the differential coder starts at 0
        LDI     r6, 0
        SETD    3                       ; anchor the air (3: no early staged edge)
        JMP     blkend

; ------------------------------------------------------------ one bit on the air
; r4 is the output bit: its biphase symbol is two staged half-symbols, a
; 1 high then low, a 0 low then high. The work for the next bit runs in
; the second half-symbol.
bit:    CMPI    r4, 0
        BZ      sym0
        SETP    TXD, 1, D               ; first half, at the bit's start
        WAITD   1
        SETP    TXD, 0, D               ; second half, at the middle
        WAITD   1
        JMP     work
sym0:   SETP    TXD, 0, D
        WAITD   1
        SETP    TXD, 1, D
        WAITD   1
work:   CMPI    r2, 17                  ; C = past the information word
        BC      w0
        SHO                             ; one bit of the next block into the CRC
w0:     CMPI    r2, 16
        BZ      tochk
        CMPI    r2, 26
        BZ      blkend
next:   ADDI    r2, 1
        SHLI    r0, 1                   ; C = the next data bit
        BNC     bit                     ; a 0 keeps the output
        XORI    r4, 1                   ; a 1 complements it (1.6 Table 1)
        JMP     bit
tochk:  MOV     r0, r1                  ; the checkword follows, MSB first
        JMP     next

; ------------------------------------------------------------ a block ends
; The next block's checkword is in the CRC unit; it goes on the air now,
; and the block after it goes into the CRC unit.
blkend: STCRC   r1                      ; m(x) x^10 mod g(x), in 15:6
        ADDI    r3, 1
        ANDI    r3, 15                  ; the block now on the air
        MOV     r7, r3
        ANDI    r7, 3                   ; its place in the group
        CMPI    r7, 2
        BNZ     be0
        ADD     r7, r7, r6              ; block 3 of a version B group: C'
be0:    MOV16   r2, offs
        ADD     r7, r7, r2
        LD      r7, r7, 0
        XOR     r1, r1, r7              ; plus the offset word (2.3 b)
        MOV     r0, r5
        MOV     r7, r3
        ANDI    r7, 3
        CMPI    r7, 1
        BNZ     be1
        LDI     r6, 0                   ; block 2: its B0 picks C or C' for block 3
        MOV     r7, r0
        SHLI    r7, 5                   ; C = bit 11
        BNC     be1
        LDI     r6, 2
be1:    MOV     r7, r3
        ADDI    r7, 1
        ANDI    r7, 15
        MOV16   r2, tab
        ADD     r7, r7, r2
        LD      r5, r7, 0               ; the block after this one
        LDSR    r5
        CRCI
        LDI     r2, 0
        JMP     next

; ------------------------------------------------------------ data
        .org    0x060
offs:   .word   0x0FC << 6, 0x198 << 6, 0x168 << 6, 0x1B4 << 6, 0x350 << 6  ; A B C D C'
tab:    .word   0x54A8, 0x04A8, 0xE0CD, 'L' << 8 | 'O'      ; 0A, C1C0 = 00, DI d3 = 0
        .word   0x54A8, 0x04A9, 0xE0CD, 'O' << 8 | 'M'      ; C1C0 = 01, d2 = 0
        .word   0x54A8, 0x04AA, 0xE0CD, ' ' << 8 | 'R'      ; C1C0 = 10, d1 = 0
        .word   0x54A8, 0x04AF, 0xE0CD, 'D' << 8 | 'S'      ; C1C0 = 11, d0 = 1
