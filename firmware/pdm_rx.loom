; pdm_rx.loom
;
; Decisions (2026-11-03): one microphone at 1.5625 MHz, inside the
; MP34DT01-M's 1 to 3.25 MHz range but below its 2.4 MHz typical; a stereo
; pair or 2.4 MHz needs more slots per bit than one thread has. Whether
; the datasheet's 18 and 16 ns data figures are minimums or maximums is
; unclear: the program leaves 80 ns either way.
;
; PDM microphone receiver: one MEMS microphone (L/R tied to GND), clocked
; at 1.5625 MHz, decimated in firmware by a second-order CIC (R = 64) to
; 24.414 kHz PCM words in OUTQ[0]. Written on 2026-11-03, after the
; hardware was complete (D-032), as a protocol Loom was not designed for
; (D-035). It uses the deadline-latched pin write (SETP pin, v, D, built
; for clock-exact UART and WS2812 edges) for every CLK edge, IN for the
; data, the ALU and the FIFOs. What no hardware does: the microphone
; clock, the sampling point and the whole decimation filter are firmware.
; A PDM peripheral has a hardware CIC; here one thread spends every slot
; on the clock, the sample and the two integrators (see "Limits").
;
; Microphone: ST MP34DT01-M, DocID026514 Rev 3 (September 2014).
;   Table 3 / Table 5: clock 1 to 3.25 MHz in normal mode (TCLK 308 to
;   1000 ns), duty 40 to 60 %; below 0.23 MHz it powers down.
;   Table 7: L/R = GND: data valid while CLK is low, high impedance while
;   CLK is high (the right microphone of a pair drives then).
;   Table 5: TL,EN 18 ns, data enabled after the falling edge ("from design
;   simulations"; the table as extracted does not say min or max, read
;   here as a maximum: unchecked).
;
; Pins: CLK = OUT3, DAT = IN0 (move with --pin).
;
; Output (FIFO space read, thread 0): one word per 64 PDM bits, 24414 per
; second: the CIC2 output, an unsigned value 0..4096 with 2048 for a
; duty of one half (silence), i.e. sum over the last 127 bits of the PDM
; ones weighted by a triangle of height 64. The first two words after RUN
; are the filter filling up. A word due while OUTQ is full is dropped (the
; filter state is kept, so the next word is right).
;
; Rate: the program sets its own tick (16 clocks = half a CLK period), the
; host must not: CLK = 50 MHz / 32 = 1.5625 MHz, duty exactly one half.
; The schedule is proved for that tick with no slack (.csr TICK_INT
; below): each half period is exactly four slots, so the edges fall on the
; slot grid with a constant lateness and are exactly periodic (16 is a
; multiple of 4, SEMANTICS 2).
;
; Bit timing. Each PDM bit is a high half and a low half of four slots:
;     high: WAITD (CLK rises) ; ADD i1 ; ADD i2 ; SETP CLK, 0, D
;     low:  WAITD (CLK falls) ; SETP CLK, 1, D ; IN x ; <op>
; IN samples DAT two slots after the fall. Measured on the golden model
; (a microphone model whose data turns valid k clocks after the fall):
; the reading is right for k <= 4 and wrong from 5, so the pad is sampled
; at the fifth clock edge after the falling edge, 11 clocks before the
; rise. The microphone has 80 ns to drive valid data, against TL,EN 18 ns.
; The sample is added into the first integrator in the next bit's high
; half.
;
; Decimation: CIC, order 2, R = 64, M = 1. i1 += x and i2 += i1 every bit,
; modulo 2^16 (a CIC needs only that its output range, 0..4096, fits the
; width); every 64 bits c = s - z1, z1 = s, y = c - z2, z2 = c, where s
; is i2 then. The op slot of the low half is the loop's DJNZ for 54 bits;
; the last 10 bits of a block are unrolled and their op slots do the
; block's work, one each:
;     u1 MOV s, i2    u2 SUB c, s, z1    u3 MOV z1, s    u4 SUB y, c, z2
;     u5 MOV z2, c    u6 WAITB OUTQ_NF, T (a test: TD is reached)
;     u7 BT full      u8 PUSH y (declared bounded)    u9 LDI count
;     u10 JMP bits
; The `full` path replaces u8 and rejoins at u9 with the same slots.
;
; Limits (stated plainly). 1.5625 MHz is inside the microphone's range but
; below its 2.4 MHz typical; 2.4 and 3.072 MHz (64 x 48 kHz) are out of
; reach for one thread, which needs 8 slots per PDM bit. A CIC2 alone has
; the usual sinc^2 droop (-0.8 dB at 4 kHz) and lets through aliases
; near multiples of 24.4 kHz at sinc^2 strength; the output is about 12
; bits, with the first-order quantisation of the microphone's modulator
; still in it. A PCM path for audio would follow it with a half-band and a
; compensation FIR on the host. One microphone only: a stereo pair needs
; a sample in the high half too and a second pair of integrators, four
; slots per bit more than there are.
;
; Registers: r0 c, r1 x (the last sample), r2 i1, r3 i2, r4 the loop
; count, r5 s then y, r6 z1, r7 z2 (and the .csr scratch before it).

        .imem   512
        .thread 0
        .pins   CLK = OUT3, DAT = IN0
        .equ    NLOOP = 54              ; bits 1..54 of a block in the loop

start:  .csr    TICK_INT, 16            ; half a CLK period: 1.5625 MHz
        .csr    TICK_FRAC, 0
        .csr    INGRP, pin(DAT) | (1 << 5)  ; IN reads DAT into bit 0
        SETP    CLK, 0                  ; CLK idles low
        OEP     CLK, 1                  ; a no-op on OUT pins, needed on BIDIR
        LDI     r1, 0
        LDI     r2, 0
        LDI     r3, 0
        LDI     r6, 0
        LDI     r7, 0
        LDI     r4, NLOOP
        SETP    CLK, 1, D               ; stage the first rise
        SETD    1                       ; and anchor its deadline

; ------------------------------------------------- bits 1..54 of a block
bits:   WAITD   1                       ; CLK rises
        ADD     r2, r2, r1              ; i1 += x
        ADD     r3, r3, r2              ; i2 += i1
        SETP    CLK, 0, D
        WAITD   1                       ; CLK falls: DAT becomes valid
        SETP    CLK, 1, D
        IN      r1                      ; x = DAT
        DJNZ    r4, bits

; ------------------------------------------------- bits 55..64, unrolled
        WAITD   1                       ; u1
        ADD     r2, r2, r1
        ADD     r3, r3, r2
        SETP    CLK, 0, D
        WAITD   1
        SETP    CLK, 1, D
        IN      r1
        MOV     r5, r3                  ; s = i2

        WAITD   1                       ; u2
        ADD     r2, r2, r1
        ADD     r3, r3, r2
        SETP    CLK, 0, D
        WAITD   1
        SETP    CLK, 1, D
        IN      r1
        SUB     r0, r5, r6              ; c = s - z1

        WAITD   1                       ; u3
        ADD     r2, r2, r1
        ADD     r3, r3, r2
        SETP    CLK, 0, D
        WAITD   1
        SETP    CLK, 1, D
        IN      r1
        MOV     r6, r5                  ; z1 = s

        WAITD   1                       ; u4
        ADD     r2, r2, r1
        ADD     r3, r3, r2
        SETP    CLK, 0, D
        WAITD   1
        SETP    CLK, 1, D
        IN      r1
        SUB     r5, r0, r7              ; y = c - z2

        WAITD   1                       ; u5
        ADD     r2, r2, r1
        ADD     r3, r3, r2
        SETP    CLK, 0, D
        WAITD   1
        SETP    CLK, 1, D
        IN      r1
        MOV     r7, r0                  ; z2 = c

        WAITD   1                       ; u6
        ADD     r2, r2, r1
        ADD     r3, r3, r2
        SETP    CLK, 0, D
        WAITD   1
        SETP    CLK, 1, D
        IN      r1
        WAITB   OUTQ_NF, T              ; a test: TD is reached, so T = 1
                                        ; at once if OUTQ is full
        WAITD   1                       ; u7
        ADD     r2, r2, r1
        ADD     r3, r3, r2
        SETP    CLK, 0, D
        WAITD   1
        SETP    CLK, 1, D
        IN      r1
        BT      full                    ; no room: drop this word

        WAITD   1                       ; u8
        ADD     r2, r2, r1
        ADD     r3, r3, r2
        SETP    CLK, 0, D
        WAITD   1
        SETP    CLK, 1, D
        IN      r1
        .bounded "the WAITB OUTQ_NF, T of u6 completed with T = 0 (the BT of u7 fell through; nothing between them writes T), so OUTQ had room in its X cycle; only this thread pushes OUTQ and the host only pops (SEMANTICS 6.7)"
        PUSH    r5                      ; one slot: it cannot stall

u9:     WAITD   1
        ADD     r2, r2, r1
        ADD     r3, r3, r2
        SETP    CLK, 0, D
        WAITD   1
        SETP    CLK, 1, D
        IN      r1
        LDI     r4, NLOOP

        WAITD   1                       ; u10
        ADD     r2, r2, r1
        ADD     r3, r3, r2
        SETP    CLK, 0, D
        WAITD   1
        SETP    CLK, 1, D
        IN      r1
        JMP     bits

; ------------------------------------------------- u8 when OUTQ is full
full:   WAITD   1
        ADD     r2, r2, r1
        ADD     r3, r3, r2
        SETP    CLK, 0, D
        WAITD   1
        SETP    CLK, 1, D
        IN      r1
        JMP     u9                      ; the word is dropped
