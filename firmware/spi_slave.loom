; spi_slave.loom
; SPI slave, modes 0 and 3 (both sample on the rising edge), MSB first. M2
; firmware: needs the FIFOs (POP, PUSH, WAITB), nothing else.
;
; Pins: SCK = IN1, MOSI = IN2, CS_n = IN3, MISO = OUT0.
;
; Host command format (FIFO space, thread 0): one word per byte to send,
; bits 7:0; the other bits are ignored. The slave pops the next response
; byte as soon as it has finished one, so the word at the head of INQ is
; what the master's next byte reads. With INQ empty it sends IDLE (0xFF).
;
; Result format (FIFO space read): one word per byte the master clocked in,
; bits 7:0 the byte as sampled on MOSI. A byte that arrives while OUTQ is
; full is dropped (the host is not keeping up); nothing else is lost.
;
; Modes: in mode 0 (CPOL 0, CPHA 0) and in mode 3 (CPOL 1, CPHA 1) the
; master samples MOSI and MISO on the rising edge of SCK, so one loop serves
; both; this program never looks at the idle level or at the falling edge.
; Modes 1 and 2 sample on the falling edge and are not supported.
;
; Rate: the slave follows the master's SCK and keeps no schedule of its own.
; It writes MISO six slots after the X cycle in which it sees the sampling
; edge, seven when the bit it just sampled was a 1 (the ORI); that X cycle
; comes the pad's two synchroniser clocks and up to three more after the
; edge, and the pin follows two clocks after the write: 28 or 32 clocks after
; the edge in the tests, 28 to 35 at any phase of SCK against the slot grid.
; That is after the edge, whatever the master's hold time, and long before
; the next one. The limit is the work between two bytes (push the byte
; received, pop the next one to send, put its first bit on MISO): from the X
; cycle that sees a byte's last sampling edge, the new bit 7 is on MISO after
; 22 slots and the slave waits for the next edge from slot 27, so a master
; clocking bytes back to back needs an SCK period of about 110 clocks or
; more (not tested faster than the tests' 128 clocks, 390 kHz at 50 MHz).
; The tick only times the silence before CS_n is looked at (TMO ticks); the
; tests set it to a quarter of the SCK period, TICK_INT 32.
;
; (The first version changed MISO one tick after the edge, with SETD 0 on
; the edge and WAITD 1: after an edge the SETD can fall anywhere in a tick,
; so that deadline could not be met in general, only by an SCK in step with
; the tick; tools finding T-1, docs/VERIFICATION.md.)
;
; Selection: while CS_n is high the slave watches INQ and pre-loads the next
; response byte as soon as one is queued, so its first bit is on MISO before
; the master may raise SCK two slots after CS_n falls. A host that queues
; nothing before the transaction starts gets IDLE for that byte. MISO keeps
; the last bit it drove while deselected (a Tiny Tapeout output pad cannot
; be let go).
;
; If SCK stops inside a byte for TMO ticks the slave looks at CS_n: a master
; that still selects us is only pausing, and the wait is resumed; a master
; that has deselected us has cut the transaction short, so the partial byte
; is dropped and the slave resynchronises on the next selection. That is
; also how the end of every transaction is noticed.
;
; Registers: r0 the byte to send, reversed, next bit in bit 0; r1 bit count;
; r2 the byte being received; r4 scratch for the idle level; r6 "a byte from
; the host is loaded and none of it has gone out yet", so that a byte
; pre-loaded at the end of one transaction is not thrown away by the next
; pre-load and a filler byte is replaced as soon as the host queues one;
; r7 .csr scratch.

        .thread 0
        .pins   SCK = IN1, MOSI = IN2, CS_N = IN3, MISO = OUT0
        .tick   32                      ; a quarter of an SCK period
        .equ    IDLE = 0xFF             ; sent when the host has queued nothing
        .equ    TMO = 16                ; ticks of silence before CS_n is checked

start:  .csr    OUTGRP, 16 | (1 << 5)   ; OUT drives MISO (OUT0) alone; clobbers r7
        LDI     r4, 0
        OUT     r4                      ; MISO low until the first byte is loaded

idle:   WAITP   CS_N, 1                 ; deselected (a partial byte is dropped)
        TEST    r6, r6
        BNZ     armed                   ; a host byte is loaded and still unsent
poll:   SETD    0                       ; TD = NOW, so the WAITB only tests INQ
        WAITB   INQ_NE, T
        BT      nobyte
        CALL    load                    ; a byte is queued: pre-load it
armed:  WAITP   CS_N, 0                 ; selected: the master may clock now
        JMP     bit
nobyte: JP      CS_N, 1, poll           ; nothing to send yet: look again
        JMP     byte                    ; selected with INQ empty: send IDLE

; One byte. `load` returns into `bit`, which saves the jump back on the path
; between two bytes: that path is what limits the SCK rate.
byte:   CALL    load                    ; the next byte to send, first bit on MISO
bit:    SETD    TMO                     ; the wait below gives up after TMO ticks
        WAITE   SCK, RISE, T            ; the master samples MOSI and MISO here
        BT      quiet
        SHLI    r2, 1
        JP      MOSI, 0, m0             ; sample MOSI
        ORI     r2, 1
m0:     SHRI    r0, 1                   ; the next bit to send, into bit 0
        LDI     r6, 0                   ; this byte has left the queue for good
        OUT     r0                      ; the next bit on MISO, 6 slots after the edge
        DJNZ    r1, bit

        SETD    0                       ; TD = NOW: the WAITB cannot block
        WAITB   OUTQ_NF, T
        BT      drop                    ; OUTQ full: this byte is lost
        PUSH    r2
drop:   JP      CS_N, 0, byte           ; still selected: on to the next byte
        JMP     idle                    ; deselected: resynchronise

quiet:  JP      CS_N, 0, bit            ; only a pause: keep waiting for the edge
        JMP     idle                    ; deselected mid-byte: start again

; The next byte to send, reversed so that a SHRI feeds MISO, with its first
; bit already on the pin. Never blocks: the WAITB is timed and its deadline
; has passed, so INQ is only tested, not waited for.
load:   SETD    0
        WAITB   INQ_NE, T
        BT      noq
        POP     r0
        REV     r0, r0                  ; bit 7 of the byte to bit 8 ...
        SHRI    r0, 8                   ; ... and down to bit 0
        LDI     r6, 1                   ; a host byte is loaded and unsent
pres:   OUT     r0                      ; bit 7 on MISO before the first edge
        LDI     r1, 8                   ; (the loop shifts before every later bit)
        LDI     r2, 0
        RET
noq:    LDI     r0, IDLE                ; nothing queued: send 0xFF
        LDI     r6, 0                   ; ... which a queued byte may replace
        JMP     pres
