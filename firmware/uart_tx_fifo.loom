; uart_tx_fifo.loom
; 8N1 UART transmitter on OUT0, fed by the host through INQ[0]. M2 firmware:
; needs the FIFOs (POP), nothing else.
;
; Host command format (FIFO space, thread 0): one word per byte.
;     bits 7:0   the byte to send (LSB first on the wire)
;     bits 15:8  ignored
; Nothing is ever pushed to OUTQ.
;
; Bit rate: one tick is one bit. The host sets the rate before RUN through
; the debug space, TICK_INT = clocks per bit (and TICK_FRAC for the fraction):
;     50 MHz, 115200 baud:  TICK_INT 434 (0.01 % fast), or 434 + TICK_FRAC 8
;     tests (tools/tests/test_fw_uart.py): TICK_INT 32, 1.5625 Mbaud at 50 MHz
; The schedule is proved for TICK_INT >= 24 (.tick below); the reset value 1
; is far too fast, so always set the rate first.
;
; Timing. Every pin write is the first instruction after the WAITD that
; times it, so every edge lands the same one slot after its deadline (plus
; 0 to 3 clocks of slot-grid lateness, SEMANTICS 2): with a tick that is a
; multiple of 4 clocks the edges are exactly periodic, otherwise they dither
; by one slot and never drift. After the stop bit a non-blocking test
; (WAITB INQ_NE, T: the stop bit's deadline has passed, so it returns at
; once, T = 0 exactly when a word is queued; SEMANTICS 6.4) splits the two
; cases:
;   - a word is queued: it goes out back to back, one tick after the stop
;     bit, still timed from the stop bit's WAITD: exactly one stop bit;
;   - nothing is queued: POP blocks, and SETD 1 then WAITD 1 puts the start
;     bit on the second tick boundary after the POP returns, so it is a whole
;     bit whatever point of a tick the POP returned at.
; (The first version used SETD 0 for both. After a POP that blocked, the
; SETD can run anywhere in a tick, and its WAITD 1 was late whenever the next
; tick came within two slots, which shortened the start bit by up to 7
; clocks: tools finding T-1, docs/VERIFICATION.md.)

        .thread 0
        .pins   TX = OUT0
        .tick   24                      ; the fastest rate the schedule is proved for

start:  SETP    TX, 1                   ; the line idles high
        JMP     idle

stop:   LDI     r1, 8                   ; the next byte's bit count, ahead of time
        WAITD   1
        SETP    TX, 1                   ; stop bit
byte:   WAITB   INQ_NE, T               ; TD has passed: T = 0 only if a word is queued
        BT      idle
        .bounded "the WAITB INQ_NE, T just before completed by its condition, so INQ holds a word"
        POP     r0                      ; cannot block
        WAITD   1                       ; one tick after the stop bit: one stop bit
        SETP    TX, 0                   ; start bit

bit:    SHRI    r0, 1                   ; C = the next data bit, LSB first
        BC      one
        WAITD   1
        SETP    TX, 0
        DJNZ    r1, bit
        JMP     stop
one:    WAITD   1
        SETP    TX, 1
        DJNZ    r1, bit
        JMP     stop

idle:   POP     r0                      ; next word from the host (blocks while empty)
        LDI     r1, 8                   ; eight data bits
        SETD    1                       ; TD a whole tick past the next boundary
        WAITD   1                       ; so the start bit is a whole bit
        SETP    TX, 0                   ; start bit
        JMP     bit
